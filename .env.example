# OA — core platform (DOCUHIVE_)
DOCUHIVE_ENV=dev
DOCUHIVE_DATABASE_URL=postgresql+psycopg://docuhive:docuhive@localhost:5432/docuhive
DOCUHIVE_VAULT_DIR=./data/vault
DOCUHIVE_STAGING_DIR=./data/staging
# DOCUHIVE_OVERLAY_DIR=./overlay
# Required in production: generate at least 32 random bytes; never commit the value.
# DOCUHIVE_SECRET_KEY=
DOCUHIVE_AUTH_DISABLED=false
DOCUHIVE_MAX_UPLOAD_MB=100
DOCUHIVE_OCR_LANGUAGES=deu+eng
DOCUHIVE_OCR_JOBS=2
DOCUHIVE_PUBLIC_URL=http://localhost:3000
DOCUHIVE_API_URL=http://127.0.0.1:8000
DOCUHIVE_GOTENBERG_URL=http://127.0.0.1:3001

# CL — AI (DOCUHIVE_AI_): CL appends its settings here.

# CL — email (DOCUHIVE_MAIL_): CL appends its settings here.

# OA — capture: blank consume path uses VAULT_DIR/consume; blank owner ignores loose files.
# DOCUHIVE_CONSUME_DIR=
# DOCUHIVE_CONSUME_DEFAULT_OWNER=

# OA — production Compose (use a separate .env.production, mode 600).
# DOCUHIVE_IMAGE=docuhive:<git-sha>
# DOCUHIVE_WEB_IMAGE=docuhive-web:<git-sha>
# POSTGRES_PASSWORD=<random-password-also-used-in-DATABASE_URL>
# DOCUHIVE_VAULT_HOST_DIR=/srv/docuhive/vault
# DOCUHIVE_STAGING_HOST_DIR=/srv/docuhive/staging
# DOCUHIVE_PG_HOST_DIR=/srv/docuhive/pg
# DOCUHIVE_OVERLAY_HOST_DIR=/srv/docuhive/overlay
# Backup service environment: see docs/setup/operations.md.
# DOCUHIVE_PROD_ENV=/opt/docuhive/.env.production
# DOCUHIVE_VAULT_ID=<id-from-the-initialised-mounted-vault>
# DOCUHIVE_BACKUP_STATE_DIR=/srv/docuhive/backup
# RESTIC_REPOSITORIES=/mnt/usb/restic b2:bucket:docuhive
# RESTIC_PASSWORD_FILE=/etc/docuhive/restic-password
# RESTIC_CACHE_DIR=/var/cache/docuhive
