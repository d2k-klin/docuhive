# HTTPS on the home network, with a certificate from Caddy's own local authority.
# Used only with deploy/compose.lan.yml; see docs/setup/local-network.md.
{
	admin off
	skip_install_trust
	auto_https disable_redirects
	# Phones that open the address by number send no server name.
	default_sni {$DOCUHIVE_LAN_HOST}
}

https://{$DOCUHIVE_LAN_HOST}:8443 {
	tls internal
	reverse_proxy web:3000
}

# Plain HTTP only hands out the authority's public certificate and points to HTTPS.
http://:8080 {
	handle /docuhive-root.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}
	handle {
		redir https://{$DOCUHIVE_LAN_HOST}{uri}
	}
}
